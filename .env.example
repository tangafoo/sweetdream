# ─── Supabase Postgres (via Prisma) ──────────────────────────────────────────
# Pooled connection (pgbouncer, port 6543) — used at runtime.
# Supabase dashboard → Connect → Transaction pooler. Keep the query params!
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by prisma migrate / db push only.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# Public bucket base URL (no trailing slash), e.g. https://pub-xxxx.r2.dev
# or a custom domain. Leave unset to develop with designed placeholders.
NEXT_PUBLIC_R2_PUBLIC_URL=""
# S3-compatible API credentials (R2 → Manage API Tokens → Object Read & Write)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# ─── Cloudflare Turnstile (review form bot check) ────────────────────────────
# Unset in dev = verification is skipped with a console warning.
# Unset in production = review submissions are rejected (fail closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ─── OpenAI (review text + image moderation, omni-moderation-latest) ─────────
OPENAI_API_KEY=""

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Unset = falls back to a per-instance in-memory limiter (dev only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Random salt for hashing reviewer IPs (audit trail). `openssl rand -hex 32`
IP_HASH_SALT=""
